# Prompt-Injection Guard - configuration template.
# Copy to .env and adjust if you run behind a process manager that reads it.
# The app itself reads these variables from the environment; all have
# safe defaults, and the app needs NO secrets or API keys to run.

PORT=8000

# Verdict thresholds (risk score 0-100)
GUARD_FLAG_THRESHOLD=30
GUARD_BLOCK_THRESHOLD=65

# Request hardening
GUARD_MAX_PROMPT_CHARS=4000
GUARD_MAX_BODY_BYTES=16384
GUARD_RATE_LIMIT=30
GUARD_RATE_WINDOW_SECONDS=60
